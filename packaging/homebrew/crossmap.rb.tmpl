class Crossmap < Formula
  desc "Use an iPhone plugged into another Mac, across networks"
  homepage "https://github.com/wtfchewy/crossmap"
  version "@VERSION@"
  license "BSD-3-Clause"

  # Prebuilt binaries, so installing needs neither a Go toolchain nor a
  # Command Line Tools version that matches the running macOS.
  on_macos do
    on_arm do
      url "https://github.com/wtfchewy/crossmap/releases/download/v@VERSION@/crossmap_@VERSION@_darwin_arm64.tar.gz"
      sha256 "@SHA256_ARM64@"
    end
    on_intel do
      url "https://github.com/wtfchewy/crossmap/releases/download/v@VERSION@/crossmap_@VERSION@_darwin_amd64.tar.gz"
      sha256 "@SHA256_AMD64@"
    end
  end

  head do
    url "https://github.com/wtfchewy/crossmap.git", branch: "main"
    depends_on "go" => :build
  end

  def install
    if build.head?
      system "go", "build", *std_go_args(ldflags: "-s -w -X main.version=#{version}"), "./cmd/crossmap"
    else
      bin.install "crossmap"
    end
  end

  def caveats
    <<~EOS
      Create a shared key, then run `crossmap join <key>` on the other Mac:
        crossmap init

      On the Mac the iPhone is plugged into:
        crossmap agent

      On the Mac with Xcode, for libimobiledevice tools:
        crossmap host --agent <other-mac>
        export USBMUXD_SOCKET_ADDRESS=UNIX:$HOME/.config/crossmap/usbmuxd.sock

      For Xcode and devicectl, which need the system socket:
        sudo crossmap host --agent <other-mac> --system

      Installing .ipa files also needs:
        brew install ideviceinstaller

      Check a machine's setup with:
        crossmap doctor
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/crossmap version")
    # doctor exits non-zero when a check fails (no key on a fresh machine),
    # but it must still produce its report.
    output = shell_output("#{bin}/crossmap doctor 2>&1", 1)
    assert_match "usbmuxd socket", output
  end
end
